---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import mosque from '../assets/pics/mosque.jpeg';

const links = [
  { label: 'past work', href: '/past-work/' },
  { label: 'projects', href: '/projects/' },
  { label: 'writing', href: '/writing/' },
  { label: 'creative', href: '/creative/' },
  { label: 'email', href: 'mailto:leylasalken@gmail.com' },
];
---

<Base themeColor="#1B2340">
  <main class="glass" data-fog-stage>
    <Picture
      src={mosque}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="(max-aspect-ratio: 3/2) 150vh, 100vw"
      alt="Minarets and a crescent moon in blue dusk light"
      class="photo"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="shade" aria-hidden="true"></div>

    <div class="behind" data-fog-keep>
      <h1>Leyla <span>Salken</span></h1>
      <p>
        I study mathematics, sprinkled with some computer science, at Williams. Oxford last year; Jane Street this
        summer.
      </p>
      <nav aria-label="Main">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>

    <canvas class="fog" aria-hidden="true"></canvas>
    <p class="hint" aria-hidden="true">it’s cold outside — wipe the glass</p>
  </main>
</Base>

<script>
  import { initFog } from '../scripts/fog';

  const stage = document.querySelector<HTMLElement>('[data-fog-stage]');
  const canvas = stage?.querySelector<HTMLCanvasElement>('canvas.fog');
  if (stage && canvas) initFog(stage, canvas);
</script>

<style>
  .glass {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 480px;
    overflow: hidden;
    background: #1b2340;
    color: #fff;
    cursor: crosshair;
    /* a finger drags to wipe instead of scrolling; pinch-zoom still works */
    touch-action: pinch-zoom;
  }

  .glass :global(img.photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: slow 40s ease-in-out infinite alternate;
  }

  @keyframes slow {
    from {
      transform: scale(1.04);
    }
    to {
      transform: scale(1.12) translate(-1%, -1%);
    }
  }

  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 14, 40, 0) 45%, rgba(10, 14, 40, 0.55));
  }

  .behind {
    position: absolute;
    left: 72px;
    bottom: 72px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 720px;
  }

  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(96px, 9.17vw, 132px);
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.25);
  }

  .behind p {
    font-size: 19px;
    line-height: 1.5;
    max-width: 560px;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }

  nav {
    display: flex;
    gap: 28px;
    margin-top: 6px;
  }

  nav a {
    color: #fff;
    text-decoration: none;
    font: 500 16px/1.2 var(--ui);
    padding: 8px 0 3px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    transition: border-color 0.2s;
  }

  nav a:hover {
    border-bottom-color: #fff;
  }

  nav a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
    border-radius: 2px;
  }

  .fog {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hint {
    position: absolute;
    right: 40px;
    top: 34px;
    font-size: 13px;
    color: #2b3550;
    background: rgba(255, 255, 255, 0.55);
    padding: 6px 12px;
    border-radius: 999px;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    pointer-events: none;
  }

  /* tablets and small laptops */
  @media (max-width: 900px) {
    .behind {
      left: 40px;
      right: 40px;
      bottom: 48px;
    }
  }

  /* phones: the name breaks onto two lines and gets as big as the screen allows */
  @media (max-width: 600px) {
    .glass {
      -webkit-user-select: none;
      user-select: none;
      -webkit-touch-callout: none;
    }

    /* frame the two tall minarets and the moon */
    .glass :global(img.photo) {
      object-position: 19% 50%;
    }

    .behind {
      left: 22px;
      right: 22px;
      bottom: calc(30px + env(safe-area-inset-bottom));
      gap: 16px;
    }

    h1 {
      font-size: min(29vw, 132px);
      line-height: 0.84;
    }

    h1 span {
      display: block;
    }

    .behind p {
      font-size: 17px;
    }

    nav {
      gap: 16px;
      margin-top: 2px;
      justify-content: space-between;
    }

    nav a {
      font-size: 15px;
    }

    .hint {
      right: 16px;
      top: calc(16px + env(safe-area-inset-top));
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glass :global(img.photo) {
      animation: none;
      transform: scale(1.04);
    }
  }
</style>
