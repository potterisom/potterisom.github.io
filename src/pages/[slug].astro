---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import 'katex/dist/katex.min.css';
import fs from 'node:fs';
import katex from 'katex';
import { macros } from '../../astro.config.mjs';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort((a, b) => a.data.order - b.data.order);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const { Content } = await render(post);
// Paper title: plain text with $...$ math, typeset like the amsart title.
const paperTitleHtml = post.data.paperTitle
  ?.split(/(\$[^$]+\$)/)
  .map((part) => part.startsWith('$')
    ? katex.renderToString(part.slice(1, -1), { throwOnError: true, macros: { ...macros } })
    : part.replace(/&/g, '&amp;').replace(/</g, '&lt;'))
  .join('');
// Handwritten titles share one scale, so the letters are the same size on every page.
let handWidth: number | undefined;
if (post.data.hand) {
  const svg = fs.readFileSync(`public${post.data.hand}`, 'utf8');
  const w = Number(svg.match(/width="([\d.]+)"/)?.[1]);
  if (w) handWidth = Math.round((w - 40) * 0.18);
}
const d = post.data.date;
const dateText = d ? d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : null;
---
<Base title={post.data.title}>
  <div class="page">
    <aside>
      <nav aria-label="All posts">
        <a class="home" href="/"><img src="/hand/name.svg" alt="Leyla Salken, home" width="220" height="60" /></a>
        {posts.map((p, i) => (
          <a class:list={['sb', 'imp', { on: p.id === post.id }]} href={`/${p.id}/`} data-note={i}
             aria-current={p.id === post.id ? 'page' : undefined}>{p.data.title}</a>
        ))}
      </nav>
    </aside>
    <main>
      {post.data.paperTitle ? (
        <article class="paper">
          <h1 class="ptitle" set:html={paperTitleHtml} />
          {post.data.author && <p class="pauthor">{post.data.author}</p>}
          <Content />
          <div class="pfoot">
            {dateText && <p><i>Date</i>: {dateText}.</p>}
            {post.data.thanks && <p>{post.data.thanks}</p>}
          </div>
          {post.data.pdf && <p class="pdf"><a class="ln" href={post.data.pdf}>pdf ↗</a></p>}
        </article>
      ) : (
        <article>
          <h1>{post.data.hand ? <img src={post.data.hand} alt={post.data.title} style={handWidth ? `width:min(${handWidth}px,100%)` : undefined} /> : post.data.title}</h1>
          <Content />
          {dateText && <p class="dt">{dateText}</p>}
          {post.data.pdf && <p><a class="ln" href={post.data.pdf}>pdf ↗</a></p>}
        </article>
      )}
    </main>
  </div>
</Base>

<style>
  .page{display:flex;min-height:100vh}
  aside{position:sticky;top:0;height:100vh;width:380px;flex:none;overflow:auto;
    background:linear-gradient(rgba(226,232,242,.82),rgba(226,232,242,.82)),url(/pics/mosque-small.webp) center/cover}
  aside nav{padding:44px 40px;display:flex;flex-direction:column;gap:1px}
  .home{display:block;line-height:0;margin-bottom:28px;align-self:flex-start}
  .home img{width:220px;height:auto}
  .sb{display:block;padding:4px 12px;margin:0 -12px;border-radius:8px;font-family:var(--sans);font-size:15.5px;line-height:1.3;color:var(--soft);text-decoration:none;transition:transform .4s cubic-bezier(.2,1.5,.3,1)}
  .sb:hover,.sb:focus-visible{transform:translateX(4px)}
  .sb.on{box-shadow:inset 0 0 0 1px rgba(18,24,49,.28)}
  main{flex:1;min-width:0;padding:90px 24px}
  article{max-width:640px;margin:0 auto;font-size:17px;line-height:1.65;color:var(--ink)}
  h1{margin:0 0 36px;line-height:0}
  h1 img{height:auto}

  article :global(p){margin:0 0 .9em}
  article :global(h2){font-weight:700;font-size:20px;line-height:1.3;margin:1.4em 0 .5em;color:var(--navy)}
  article :global(.ab){font-size:15.5px;line-height:1.55;margin:0 0 1.6em;padding:0 28px}
  article :global(.sc){font-variant:small-caps;font-weight:700}
  article :global(.katex-display){overflow-x:auto;overflow-y:hidden;margin:.5em 0 1em;padding:.1em 0}
  article :global(.katex){font-size:1em}
  article :global(ol),article :global(ul){margin:.2em 0 1em;padding-left:1.4em}
  article :global(li){margin:0 0 .5em}
  article :global(.qed){float:right;margin-left:1em}
  article :global(.ln){color:var(--navy);text-decoration:underline;text-underline-offset:3px}
  article :global(.dt){margin-top:2em;color:#5a5448;font-size:14.5px}
  article :global(.footnotes){margin-top:2em;padding-top:.8em;border-top:1px solid rgba(20,18,16,.18);font-size:14px}
  article :global(.footnotes h2){position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  article :global(blockquote){margin:0 0 1.8em;padding:0}
  article :global(blockquote p){margin:0 0 .3em}
  article :global(cite){font-style:italic;font-size:14.5px;color:#5a5448}
  article :global(.job h2){margin:1.2em 0 .1em;font-size:18px}
  article :global(.rl){margin:0 0 .4em;font-style:italic;font-size:14.5px;color:#5a5448}
  article :global(.job ul){font-size:15.5px;line-height:1.5}

  /* ---------- papers: typeset like the amsart PDFs ---------- */
  .paper{text-align:justify;hyphens:auto;-webkit-hyphens:auto;line-height:1.38}
  .paper :global(p){margin:0 0 .75em}
  .ptitle{margin:0;text-align:center;font-weight:700;text-transform:uppercase;font-size:1em;line-height:1.4;color:var(--ink)}
  .pauthor{margin:1.6em 0 2.6em;text-align:center;text-transform:uppercase;font-family:'LM Roman 10',var(--serif);font-size:.83em}
  .paper :global(.ab){margin:0 3em 2.2em;padding:0;font-family:'LM Roman 10',var(--serif);font-size:.83em;line-height:1.38}
  .paper :global(.ab p){margin:0}
  .paper :global(.sc){font-family:'LM Roman Caps 10',var(--serif);font-weight:400;font-variant:normal}
  .paper :global(h2.sec){margin:1.9em 0 1em;text-align:center;font-family:'LM Roman Caps 10',var(--serif);font-weight:400;font-size:1em;color:var(--ink);line-height:1.4}
  .paper :global(.tl){color:#0000ff;text-decoration:none}
  .paper :global(.thm){margin:1em 0 1.2em}
  .paper :global(.thm p){margin:0}
  .paper :global(.katex-display){margin:.6em 0}
  .paper :global(ol){padding-left:2.4em}
  .paper :global(li){margin:0 0 .25em;padding-left:.3em}
  .paper :global(.footnotes),.pfoot{font-family:'LM Roman 10',var(--serif);font-size:.83em;border-top:none;margin-top:2.4em;padding-top:0}
  .paper :global(.footnotes)::before,.pfoot::before{content:"";display:block;width:8em;border-top:1px solid var(--ink);margin-bottom:.5em}
  .paper :global(.footnotes) + .pfoot{margin-top:.4em}
  .paper :global(.footnotes) + .pfoot::before{display:none}
  .pfoot p{margin:0 0 .2em;text-align:left}
  .paper .pdf{margin-top:2em}
  @media (max-width:900px){ .paper :global(.ab){margin:0 0 1.8em} }

  @media (max-width:900px){
    .page{flex-direction:column}
    aside{position:relative;height:auto;width:100%}
    aside nav{padding:28px 24px}
    main{padding:48px 20px 80px}
    article{font-size:16px}
    article :global(.ab){padding:0;font-size:15px}
    article :global(h2){font-size:18.5px}
  }
</style>

<script>
  import { wireSound, sidebarNote } from '../scripts/sound';
  import { wirePaint } from '../scripts/paint';
  wireSound(sidebarNote);
  wirePaint();
</script>
